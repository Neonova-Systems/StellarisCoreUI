{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "module": "ES2022",
    "target": "ES2020",
    "lib": ["ES2023"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "baseUrl": ".",
    "types": ["@girs/astal-3.0"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "env.d.ts",
    "@girs/**/*.d.ts"
  ]
}