#!/usr/bin/env bash

set -euo pipefail

value="${1:-}"

if ! command -v brightnessctl >/dev/null 2>&1; then
	echo "brightnessctl is required but not installed." >&2
	exit 1
fi

if [[ -z "$value" ]]; then
	echo "Usage: $0 <0-100>" >&2
	exit 1
fi

if [[ ! "$value" =~ ^[0-9]+$ ]]; then
	echo "Invalid value: $value" >&2
	echo "Usage: $0 <0-100>" >&2
	exit 1
fi

# A true 0% can black out the panel, so keep the floor at 1 the way
# brightnessctl's own --min-value does.
if (( value < 1 )); then
	value=1
elif (( value > 100 )); then
	value=100
fi

# -m s prints device,class,value,percent,max for the device it wrote to, so the
# applied value is read back from the same call rather than trusted from input.
if ! out="$(brightnessctl -m s "${value}%" 2>&1)"; then
	echo "Could not set brightness to ${value}%: ${out}" >&2
	exit 1
fi

applied="$(printf '%s' "$out" | cut -d, -f4 | tr -d '%')"

if [[ ! "$applied" =~ ^[0-9]+$ ]]; then
	echo "Unexpected brightnessctl output: ${out}" >&2
	exit 1
fi

printf '%s\n' "$applied"
